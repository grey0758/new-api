{
  "$schema": "https://raw.githubusercontent.com/cloudflare/workers-sdk/main/packages/wrangler/config-schema.json",
  "name": "opencodex-codex-release-cache",
  "main": "src/index.js",
  "compatibility_date": "2026-10-02",
  "workers_dev": true,
  "preview_urls": false,
  "r2_buckets": [{"binding": "PACKAGES", "bucket_name": "opencodex-codex-release-cache"}],
  "triggers": {"crons": ["0 * * * *"]},
  "observability": {"enabled": true}
}
